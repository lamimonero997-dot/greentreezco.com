# Admin dashboard password, used to unlock /admin when Supabase is not
# configured. Three wrong tries lock the form for 3 minutes.
#
# Leave both of these blank to use the built-in password:
#   GTz-4D8F-YZFZ-cG8k-t9i6-!7
#
# Anything in a VITE_ variable is readable in the shipped JavaScript, so prefer
# the digest form - it keeps the password itself out of the bundle. Generate one
# with:
#   node -e "console.log(require('crypto').createHash('sha256').update('your password').digest('hex'))"
VITE_ADMIN_PASSWORD_SHA256=
VITE_ADMIN_PASSWORD=

# Email delivery for the contact form and a copy of every checkout.
#
# The site is a static bundle with no mail server, so it posts to Web3Forms.
# The shop's own key is already built into src/lib/email.js and delivers to
# info@greentreezco.com, so this only needs filling in to point mail somewhere
# else - a staging inbox, say. Keys are free from https://web3forms.com.
VITE_WEB3FORMS_KEY=

# Shown next to the contact form. Must match the inbox the key was created for.
VITE_CONTACT_EMAIL=info@greentreezco.com

# Optional: persist catalog in Supabase instead of this browser.
# Create a project at https://supabase.com, run supabase/schema.sql, then:
#   npm run catalog:seed
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only key for npm run catalog:seed — never put this in VITE_ vars
SUPABASE_SERVICE_ROLE_KEY=
